Node BTN2_3 {

	logic = BTN2_3;
	rate_up = @logic ? $u_BTN2_3 : 0;
	rate_down = @logic ? 0 : $d_BTN2_3;
}

Node gdTCR {

	logic = (iden_gdTCR AND (BTN2_3 AND (LCK AND NOT THSHP1)));
	rate_up = @logic AND (R103 OR TR103) ? 100.0 : (@logic AND (NOT R103 AND NOT TR103) ? 1.0: 0);
	rate_down = @logic ? 0 : $d_gdTCR;
}

Node R103 {

	logic = (iden_R103 AND ((BTN2_3 OR BTN3A_cis)));
	rate_up = @logic ? $u_R103 : 0;
	rate_down = @logic ? 0 : $d_R103;
}

Node TR103 {

