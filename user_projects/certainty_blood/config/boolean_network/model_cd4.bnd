}

Node CD4 {

	logic = CD4;
	rate_up = @logic ? $u_CD4 : 0;
	rate_down = @logic ? 0 : $d_CD4;
}

Node LCK {

	logic = (((CD45 OR (CD4 OR LCK))) AND (NOT TIM3R AND NOT LAG3R));
	rate_up = @logic ? $u_LCK : 0;
	rate_down = @logic ? 0 : $d_LCK;
}

Node TIM3R {

	logic = (TIM3_L AND TIM3);
