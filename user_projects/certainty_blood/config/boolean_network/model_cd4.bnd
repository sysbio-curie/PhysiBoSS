Node cMYC {

	logic = (mTORC1 OR ERK);
	rate_up = @logic ? $u_cMYC : 0;
	rate_down = @logic ? 0 : $d_cMYC;
}

Node IL7_L {

	logic = IL7_L;
	rate_up = @logic ? $u_IL7_L : 0;
	rate_down = @logic ? 0 : $d_IL7_L;
}

Node IL7Rt {

	logic = FOXO1;
	rate_up = @logic ? $u_IL7Rt : 0;
	rate_down = @logic ? 0 : $d_IL7Rt;
}

Node memory {

	logic = IL7Rt;
	rate_up = @logic ? $u_memory : 0;
	rate_down = @logic ? 0 : $d_memory;
}

Node KLF2 {

	logic = FOXO1;
	rate_up = @logic ? $u_KLF2 : 0;
	rate_down = @logic ? 0 : $d_KLF2;
}

Node Exhaustion {

	logic = (TIM3 OR (TIGIT OR (PD1 OR LAG3)));
	rate_up = @logic ? $u_Exhaustion : 0;
	rate_down = @logic ? 0 : $d_Exhaustion;
}

Node FAS_L {

	logic = FAS_L;
	rate_up = @logic ? $u_FAS_L : 0;
	rate_down = @logic ? 0 : $d_FAS_L;
}

Node FAS {

	logic = (FAS_L AND FAS);
	rate_up = @logic ? $u_FAS : 0;
	rate_down = @logic ? 0 : $d_FAS;
}

Node FLIP {

	logic = NFKB;
	rate_up = @logic ? $u_FLIP : 0;
	rate_down = @logic ? 0 : $d_FLIP;
}

Node TIGIT_L {

	logic = TIGIT_L;
	rate_up = @logic ? $u_TIGIT_L : 0;
	rate_down = @logic ? 0 : $d_TIGIT_L;
}

Node PD1_L {

	logic = TIGIT_L;
	rate_up = @logic ? $u_PD1_L : 0;
	rate_down = @logic ? 0 : $d_PD1_L;
}

Node ICOS_L {

	logic = ICOS_L;
	rate_up = @logic ? $u_ICOS_L : 0;
	rate_down = @logic ? 0 : $d_ICOS_L;
}

Node TIGITR {

	logic = (TIGIT_L AND TIGIT);
	rate_up = @logic ? $u_TIGITR : 0;
	rate_down = @logic ? 0 : $d_TIGITR;
}

Node PD1R {

	logic = (PD1_L AND (PD1 AND LCK));
	rate_up = @logic ? $u_PD1R : 0;
	rate_down = @logic ? 0 : $d_PD1R;
}

Node iden_R103 {

	logic = iden_R103;
	rate_up = @logic ? $u_iden_R103 : 0;
	rate_down = @logic ? 0 : $d_iden_R103;
}

Node iden_TR103 {

	logic = iden_TR103;
	rate_up = @logic ? $u_iden_TR103 : 0;
	rate_down = @logic ? 0 : $d_iden_TR103;
}

Node BTN3A_cis {

	logic = (BTN3A_cis AND iden_BTN3A_cis);
	rate_up = @logic ? $u_BTN3A_cis : 0;
	rate_down = @logic ? 0 : $d_BTN3A_cis;
}

Node ISyn {

	logic = (CAR OR (gdTCR OR abTCR));
	rate_up = @logic ? $u_ISyn : 0;
	rate_down = @logic ? 0 : $d_ISyn;
}

Node kill_potential {

	logic = (ISyn AND cytotoxic);
	rate_up = @logic ? $u_kill_potential : 0;
	rate_down = @logic ? 0 : $d_kill_potential;
}

Node YY1t {

	logic = (ATF2 AND AP1);
	rate_up = @logic ? $u_YY1t : 0;
	rate_down = @logic ? 0 : $d_YY1t;
}

Node YY1 {

	logic = YY1t;
	rate_up = @logic ? $u_YY1 : 0;
	rate_down = @logic ? 0 : $d_YY1;
}

Node iden_BTN3A_cis {

	logic = iden_BTN3A_cis;
	rate_up = @logic ? $u_iden_BTN3A_cis : 0;
	rate_down = @logic ? 0 : $d_iden_BTN3A_cis;
}
