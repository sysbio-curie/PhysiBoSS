Node THSHP1 {

	logic = (THEMIS AND SHP1);
	rate_up = @logic ? $u_THSHP1 : 0;
	rate_down = @logic ? 0 : $d_THSHP1;
}

Node abTCR {

	logic = (iden_abTCR AND (pMHCII AND (LCK AND (NOT THSHP1 AND NOT LAG3R))));
	rate_up = @logic ? $u_abTCR : 0;
	rate_down = @logic ? 0 : $d_abTCR;
}

Node iden_gdTCR {

	logic = iden_gdTCR;
