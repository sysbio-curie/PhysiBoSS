	rate_up = @logic ? $u_TR103 : 0;
	rate_down = @logic ? 0 : $d_TR103;
}

Node gdTCR_level1 {

	logic = (NOT R103 AND NOT TR103);
	rate_up = @logic ? $u_gdTCR_level1 : 0;
	rate_down = @logic ? 0 : $d_gdTCR_level1;
}

Node gdTCR_level2 {

	logic = (R103 OR TR103);
	rate_up = @logic ? $u_gdTCR_level2 : 0;
	rate_down = @logic ? 0 : $d_gdTCR_level2;
